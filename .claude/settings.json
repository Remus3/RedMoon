{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONPATH": "C:\\RedMoon"
  },
  "permissions": {
    "allow": [
      "Bash(taskkill:*)",
      "Bash(schtasks:*)",
      "mcp__computer-use",
      "mcp__Windows-MCP__Screenshot",
      "mcp__Windows-MCP__Snapshot",
      "mcp__Windows-MCP__Click",
      "mcp__Windows-MCP__Type",
      "mcp__Windows-MCP__Move",
      "mcp__Windows-MCP__Scroll",
      "mcp__Windows-MCP__Shortcut",
      "mcp__Windows-MCP__MultiSelect",
      "mcp__Windows-MCP__Wait",
      "mcp__Windows-MCP__App"
    ],
    "deny": [
      "mcp__Windows-MCP__PowerShell",
      "mcp__Windows-MCP__FileSystem",
      "mcp__Windows-MCP__Registry",
      "mcp__Windows-MCP__MultiEdit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\Python\\Python314\\pythonw.exe\" \"C:\\RedMoon\\tools\\precommit_gate.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__Windows-MCP__Scrape|mcp__computer-use__read_clipboard",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\Python\\Python314\\pythonw.exe\" \"C:\\RedMoon\\tools\\text_first_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\Python\\Python314\\pythonw.exe\" \"C:\\RedMoon\\tools\\pytest_guard.py\"",
            "timeout": 900
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\Python\\Python314\\pythonw.exe\" \"C:\\RedMoon\\tools\\rm_facts.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
