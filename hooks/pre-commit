#!/bin/sh
# Red Moon git pre-commit gate. Wiring only - the checks live in
# tools/precommit_gate.py, which is frozen (CLAUDE.md).
#
# git for Windows runs hooks through its bundled sh, so this is a shim that
# finds a Python interpreter and hands off. A missing interpreter FAILS THE
# COMMIT rather than passing quietly: a gate that cannot run has not run.
set -e

here=$(dirname "$0")

for candidate in python python3 py; do
    if command -v "$candidate" >/dev/null 2>&1; then
        exec "$candidate" "$here/precommit_hook.py"
    fi
done

echo "pre-commit: no python interpreter on PATH - commit refused" >&2
echo "pre-commit: the ASCII and ruff gate could not run, so it did not pass" >&2
exit 1
